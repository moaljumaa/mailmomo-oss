# --- Required in production -------------------------------------------------
# Public URL of the app (used for auth cookies / CSRF origin checks).
BETTER_AUTH_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------
# Where SQLite + secrets + uploads live (default ./data). Back this directory up.
DATA_DIR=./data

# Encryption key for stored IMAP/SMTP passwords and the auth secret. If unset, random
# values are generated once and stored in DATA_DIR/.secrets.json (chmod 600).
# MASTER_KEY=
# BETTER_AUTH_SECRET=

# Allow more than the first (owner) account to sign up. Leave false for self-hosting.
ALLOW_SIGNUP=false

# Extra origins allowed to call the API (comma separated), e.g. a reverse-proxy hostname.
# TRUSTED_ORIGINS=https://mail.example.com

# AI (all features degrade gracefully without a key)
# LLM_API_KEY=            # Requesty key (https://app.requesty.ai), routed via https://router.eu.requesty.ai
# LLM_BASE_URL=           # override the endpoint; ANTHROPIC_API_KEY (direct Anthropic) still works
# AI_MODEL=anthropic/claude-sonnet-5-5            # fallback only; pick the model in Settings → AI model & usage

# Redis pub/sub so multiple app processes share live updates. Optional.
# REDIS_URL=redis://localhost:6379

# How far back to download for a newly added account (older mail backfills in the background).
INITIAL_SYNC_DAYS=60

# Disable the background IMAP workers (e.g. for a read-only admin process).
# DISABLE_SYNC=false

# Do not set in production: replaces the model with a deterministic fake (used by the e2e suite).
# MAILMOMO_AI_MOCK=1

# --- Optional: fetch secrets from Infisical at container boot (docker-entrypoint.sh) ---
# If set, every other variable above is pulled from your Infisical project instead of this file.
# INFISICAL_API_URL=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
